    name = Adam Beck

[init]
    defaultBranch = main

[core]
	pager = hunk pager

[merge]
    tool = nvimdiff

[mergetool "nvimdiff"]
    cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[credential "https://github.com"]
	helper = 
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
